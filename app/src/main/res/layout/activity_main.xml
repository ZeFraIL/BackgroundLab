<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Scrollable Area for Controls -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Module 1: Java Core Threads -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Module 1: Java Core Threads" />

                <ImageView
                    android:id="@+id/info_module1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Info"
                    android:src="@android:drawable/ic_dialog_info" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/freeze_ui_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Freeze UI (ANR Demo)" />

                <Button
                    android:id="@+id/start_in_thread_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thread &amp; Crash Demo" />

                <Button
                    android:id="@+id/start_with_handler_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thread with Handler" />

                <Button
                    android:id="@+id/run_in_single_executor_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Single Thread Executor" />

                <Button
                    android:id="@+id/run_in_thread_pool_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fixed Thread Pool" />
            </LinearLayout>

            <!-- Module 2: Services -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Module 2: Services" />

                <ImageView
                    android:id="@+id/info_module2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Info"
                    android:src="@android:drawable/ic_dialog_info" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/start_foreground_service_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Foreground Service" />

                <Button
                    android:id="@+id/stop_foreground_service_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stop Foreground Service" />

                <Button
                    android:id="@+id/bind_service_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bind Service" />

                <Button
                    android:id="@+id/get_timer_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Get Timer from Service" />

                <Button
                    android:id="@+id/unbind_service_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unbind Service" />
            </LinearLayout>

            <!-- Module 3: WorkManager -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Module 3: WorkManager" />

                <ImageView
                    android:id="@+id/info_module3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Info"
                    android:src="@android:drawable/ic_dialog_info" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/one_time_work_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="One-Time Work" />

                <Button
                    android:id="@+id/periodic_work_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Periodic Work" />

                <Button
                    android:id="@+id/cancel_periodic_work_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancel Periodic Work" />

                <Button
                    android:id="@+id/constrained_work_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Work with Constraints" />

                <Button
                    android:id="@+id/chain_work_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chain of Work" />
            </LinearLayout>

            <!-- Module 4: Legacy & Deprecated -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Module 4: Legacy" />

                <ImageView
                    android:id="@+id/info_module4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Info"
                    android:src="@android:drawable/ic_dialog_info" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/run_asynctask_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run AsyncTask (Deprecated)" />

                <ProgressBar
                    android:id="@+id/async_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Fixed Log Console at the bottom -->
    <TextView
        style="@style/TextAppearance.AppCompat.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Log Console" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp" 
        android:layout_marginTop="8dp"
        android:background="#EFEFEF">

        <TextView
            android:id="@+id/log_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Log console:\n" />
    </ScrollView>

</LinearLayout>